<view class="page {{state.settings.large ? 'large' : ''}} {{state.settings.night ? 'night' : ''}}">
<view class="top-head"><view><view class="brand">知止</view><view class="sub">绿色旅途休憩伙伴</view></view><view class="route-chip">沪昆高速 · 示例走廊</view></view>
<view class="notice">演示模式 · 站点、余量、环境与碳数据均为本地示例</view>
<block wx:if="{{view === 'home'}}">
  <view class="hero">
    <view class="hero-kicker">REST WELL · GO FURTHER</view>
    <view class="hero-title"><view>赶路的你，</view><view>值得好好歇一会儿。</view></view>
    <view class="sub"><view>找一处安静，补一份能量。</view><view>下一站，我们为你安排。</view></view>
    <button bindtap="go" data-view="plan">规划我的休息旅程 ↗</button>
    <view class="hero-metrics"><view><text>3</text><label>沿途站点</label></view><view><text>96</text><label>最高指数</label></view><view><text>24'</text><label>最近到达</label></view></view>
    <view class="hero-orbit orbit-a"></view><view class="hero-orbit orbit-b"></view>
  </view>
  <view class="quick"><button wx:for="{{services}}" wx:key="id" bindtap="book" data-service="{{index}}"><text>{{item.icon}}</text><view>{{item.name}}</view><label>{{index === 0 ? '安心短休' : index === 1 ? '洗去疲惫' : index === 2 ? '细致照护' : '停车安心'}}</label></button></view>
  <button class="service-entry" bindtap="go" data-view="care"><view><text>✦ 一站式服务中心</text><label>排队取号 · 洗衣叫醒 · 车辆与亲子守护</label></view><b>进入 →</b></button>
  <view class="section-head"><view><view class="eyebrow">FULL JOURNEY CARE</view><view class="title">全旅程陪伴</view></view><view class="sub">一路安心</view></view>
  <view class="journey-grid"><button wx:for="{{journey}}" wx:key="title" bindtap="go" data-view="{{item.view}}"><view class="journey-icon">{{item.icon}}</view><label>{{item.step}}</label><view>{{item.title}}</view><text>{{item.desc}}</text></button></view>
  <view class="section-head"><view><view class="eyebrow">SELECTED STATIONS</view><view class="title">沿途好去处</view></view><button class="text-btn" bindtap="go" data-view="plan">查看路线 →</button></view>
  <view class="card station-card" wx:for="{{stations}}" wx:key="id"><image class="station-cover" mode="aspectFill" src="{{index === 0 ? '/assets/hero-service-area.jpg' : index === 1 ? '/assets/family-corner.jpg' : '/assets/rest-area.jpg'}}"></image><view class="row"><view><view class="title">{{item.name}}</view><view class="sub">{{item.road}}</view></view><view class="pill">{{item.score}} 休息指数</view></view><view class="resource-row"><view><text>{{item.parking}}</text><label>可用车位</label></view><view><text>{{item.charging}}</text><label>空闲充电</label></view><view><text>{{item.slots}}</text><label>可约空舱</label></view></view><view class="source-line"><text class="live-dot"></text>{{item.source}} · 状态需现场确认</view><button class="primary" bindtap="book" data-station="{{index}}">预约休息 ↗</button></view>
  <view class="card live-card"><view class="row"><view><view class="eyebrow">LIVE COMFORT</view><view class="title">青山站 · 此刻</view></view><view class="good">舒适</view></view><view class="weather-row"><view class="sun">☀</view><view><text class="temp">25°</text><view class="sub">体感宜人 · 演示环境</view></view></view><view class="comfort-grid"><view><text>38</text><label>dB 安静区</label></view><view><text>56</text><label>% 相对湿度</label></view><view><text>82</text><label>% 示例绿电</label></view></view><view class="tip">♧ 疗愈花园的绿荫正好，适合慢走 5 分钟。</view></view>
  <view class="section-head"><view><view class="eyebrow">CARE FOR EVERYONE</view><view class="title">为每一种奔波细心准备</view></view></view>
  <view class="persona"><view wx:for="{{personas}}" wx:key="title"><view class="persona-icon">{{item.icon}}</view><view><text>{{item.title}}</text><label>{{item.desc}}</label></view></view></view>
  <view class="card night-card"><view class="eyebrow">NIGHT CARE</view><view class="title">天黑了，也安心停靠</view><view>照明路线、停车安全、叫醒与紧急帮助集中展示。</view><button bindtap="toggle" data-key="night">切换夜间暖光 →</button></view>
</block>
<block wx:if="{{view === 'book'}}"><view class="card"><view class="title">给下一站，留个好位置</view><view>服务区</view><picker range="{{stationNames}}" value="{{stationIndex}}" bindchange="field" data-key="stationIndex"><view class="field">{{stationNames[stationIndex]}} ▾</view></picker><view>休息设施</view><picker range="{{serviceNames}}" value="{{serviceIndex}}" bindchange="field" data-key="serviceIndex"><view class="field">{{serviceNames[serviceIndex]}} · ¥{{services[serviceIndex].price}} / {{services[serviceIndex].unit}} ▾</view></picker><view>到站日期</view><picker mode="date" value="{{day}}" bindchange="field" data-key="day"><view class="field">{{day}}</view></picker><view>到站时间</view><picker mode="time" value="{{time}}" bindchange="field" data-key="time"><view class="field">{{time}}</view></picker><checkbox-group bindchange="check" data-key="proxy"><label class="check"><checkbox value="yes" checked="{{proxy}}"/>为家人代预约</label></checkbox-group><checkbox-group bindchange="check" data-key="consent"><label class="check"><checkbox value="yes" checked="{{consent}}"/>同意在本设备保存预约设施、时间和预约码</label></checkbox-group><button class="primary" bindtap="submitBooking">确认演示预约</button><view class="sub">无需手机号，无真实付款。可在我的旅程取消和改签。</view></view></block>
<block wx:if="{{view === 'plan'}}">
  <view class="card"><view class="title">全程休息规划</view><input class="field" placeholder="出发地，如杭州" value="{{origin}}" bindinput="field" data-key="origin" maxlength="50"/><input class="field" placeholder="目的地，如金华" value="{{destination}}" bindinput="field" data-key="destination" maxlength="50"/><view class="sub">优先高休息指数，避开拥挤站点。当前匹配固定示例走廊，不计算真实道路路线。</view><button class="primary" bindtap="plan">生成休息方案</button></view>
  <view class="card" wx:for="{{route}}" wx:key="id"><view class="title">{{item.name}}</view><view class="sub">{{item.tag}} · 约{{item.km}}公里</view><button bindtap="book" data-station="{{index}}">预约本站</button></view><button wx:if="{{route.length}}" bindtap="favorite">收藏路线</button>
  <view class="card"><view class="title">驾驶关怀</view><view class="sub">请安全停车后操作。此功能仅记录时间，不提供后台疲劳监测。</view><button bindtap="drive">{{state.driveStart ? '结束驾驶记录' : '开始驾驶记录'}}</button></view>
  <view class="section-head"><view><view class="eyebrow">BEFORE YOU GO</view><view class="title">推荐停靠策略</view></view><view class="sub">规划辅助</view></view>
  <view class="plan-strategy"><view><text>01</text><view><label>首次休息建议</label><b>驾驶约 90 分钟后停靠</b><small>优先选择余量充足的站点</small></view></view><view><text>02</text><view><label>组合停靠建议</label><b>短休、用餐与补能一起安排</b><small>减少重复进出服务区</small></view></view><view><text>03</text><view><label>备用方案</label><b>保留下一站作为替代</b><small>遇到排队时可快速切换</small></view></view></view>
  <view class="card plan-check"><view class="row"><view class="title">行前检查清单</view><view class="pill">建议完成</view></view><checkbox-group><label><checkbox value="vehicle"/>车辆油量、电量及胎压</label><label><checkbox value="supplies"/>饮水、常用药与儿童用品</label><label><checkbox value="offline"/>预约码和离线站内图</label><label><checkbox value="emergency"/>紧急联系人与备用路线</label></checkbox-group></view>
  <view class="card preference-help"><view class="title">规划偏好如何生效</view><view><b>避开拥挤</b><text>过滤停车余量较少的示例站点</text></view><view><b>高休息指数</b><text>按安静度和设施余量等指标排序</text></view><view><b>无障碍路线</b><text>优先展示平层入口、坡道及文字协助</text></view></view>
</block>
<block wx:if="{{view === 'map'}}"><view class="card"><view class="map-kicker">G20 青银高速 · 真实原型参考</view><view class="title">潍坊服务区（南区）· 参考导览</view><view class="sub">车行、人行与补能设施分层呈现</view><view class="map real-map refined-map"><view class="mini-compass">N<text>▲</text></view><view class="map-building"><text>综合服务楼</text><small>司机服务 · 餐饮零售 · 卫生间</small><label>主入口</label></view><view class="map-green">休憩绿地<small>林荫步道</small></view><view class="map-zone car-zone">小客车区<small>01　02　03　04</small></view><view class="map-zone truck-zone">货车区<small>A1　A2　A3</small></view><view class="map-zone charge-zone">充电区<small>⚡ ⚡ ⚡</small></view><view class="map-backend">◇<text>维修 / 后勤</text></view><view class="map-fuel">⛽<text>加油站</text></view><view class="map-walk">♿　无障碍步行主线</view><view class="map-loop">站内单向循环</view><view class="map-road">G20 青银高速　← 济南 · 青岛 →</view><view class="map-label">● 服务区入口</view><button wx:for="{{facilities}}" wx:key="id" style="left:{{item.x}}%;top:{{item.y}}%" data-id="{{item.id}}" bindtap="locate">● {{item.name}}</button></view><view class="map-note">服务建筑　·　停车补能　·　无障碍步行　·　车行分流</view><view wx:if="{{facility}}"><view class="title">{{facility.name}}</view><view>{{facility.desc}}</view><view class="sub">推荐示意：停车分区 → 无障碍步行主线 → 综合服务楼 → {{facility.name}}</view></view><view class="source-note">公开资料：G20 K150，72亩，建筑面积8906㎡。参考山东高速服务开发集团公开公告。</view><button class="primary" bindtap="scan">扫码识位</button><input class="field" placeholder="位置码，如 ZZ:s1:family" bindinput="field" data-key="positionCode"/><button bindtap="manual">识别位置码</button><button bindtap="offline">保存离线资料</button><view class="sub" wx:if="{{state.offline}}">已保存设施图及本地预约；预约码不具备线下核验效力。</view><button bindtap="go" data-view="feedback">文字呼叫 / 无障碍协助</button></view></block>
<block wx:if="{{view === 'care'}}"><view class="care-head"><view class="eyebrow">ONE STOP SERVICE</view><view class="title">智慧服务大厅</view><view class="sub">排队、补给、车辆与关怀服务统一登记</view><picker range="{{stationNames}}" value="{{stationIndex}}" bindchange="field" data-key="stationIndex"><view class="care-station">{{stationNames[stationIndex]}} ▾</view></picker></view><view class="queue-card" wx:for="{{queues}}" wx:key="id" wx:if="{{item.status === '等待中'}}"><view><label>当前号码</label><text>{{item.number}}</text></view><view><label>前方</label><text>{{item.ahead}}组</text></view><view><label>预计</label><text>{{item.eta}}分钟</text></view><button data-id="{{item.id}}" bindtap="cancelQueue">取消</button></view><view class="service-list"><view class="service-item" wx:for="{{extraServices}}" wx:key="id"><image class="service-cover" mode="aspectFill" src="{{item.id === 'tire' ? '/assets/truck-charging.jpg' : item.id === 'meal' || item.id === 'familycart' ? '/assets/family-corner.jpg' : item.id === 'accessible' ? '/assets/hero-service-area.jpg' : '/assets/rest-area.jpg'}}"></image><view class="service-icon">{{item.icon}}</view><view class="service-copy"><label>{{item.group}}</label><text>{{item.name}}</text><view>{{item.desc}}</view></view><button class="primary" data-id="{{item.id}}" bindtap="requestService">登记</button><button wx:if="{{item.id === 'laundry' || item.id === 'meal' || item.id === 'tire'}}" data-id="{{item.id}}" bindtap="takeQueue">取号</button></view></view><view class="card"><view class="title">安心守护</view><view class="guard"><view><text>▰ 车辆异动守护</text><label>演示开关，未连接监控</label></view><button data-key="vehicle" bindtap="guard">{{state.guards.vehicle ? '守护中' : '开启'}}</button></view><view class="guard"><view><text>♡ 儿童防走失提醒</text><label>演示开关，未连接定位设备</label></view><button data-key="child" bindtap="guard">{{state.guards.child ? '守护中' : '开启'}}</button></view></view></block>
<block wx:if="{{view === 'carbon'}}"><view class="card"><view class="title">我的绿色足迹</view><view class="number">{{carbon}} <text class="sub">kg CO₂ 估算减排</text></view><view>已完成 {{completed}} 次休息 · {{points}} 积分</view><view class="sub">每次休息1.2 kWh、电力因子0.5306 kg CO₂/kWh及绿电比例均为演示假设。不用于碳核证。</view></view><view class="card"><view class="title">今天的绿色行动</view><view class="green-grid"><button wx:for="{{greenCatalog}}" wx:key="key" data-key="{{item.key}}" bindtap="greenAction">♧<text>{{item.name}}</text><label>+{{item.points}}积分</label></button></view><view class="sub">自主记录，每项每日一次；未连接识别或核证系统。</view></view><view class="card"><view class="title">积分换一点美好</view><button data-name="咖啡兑换券" data-cost="80" bindtap="redeem">咖啡兑换券 · 80积分</button><button data-name="睡眠舱折扣券" data-cost="100" bindtap="redeem">睡眠舱折扣券 · 100积分</button><button data-name="生态林公益捐赠" data-cost="50" bindtap="redeem">生态林公益捐赠 · 50积分</button><view class="sub">仅演示，无实际权益或公益捐赠。</view></view><view class="card"><view class="title">兑换记录</view><view wx:for="{{state.redemptions}}" wx:key="id" class="line">{{item.name}} · {{item.cost}}积分</view><view wx:if="{{!state.redemptions.length}}" class="sub">暂无兑换</view></view></block>
<block wx:if="{{view === 'mine'}}"><view class="title">我的预约</view><view wx:if="{{!bookings.length}}" class="empty">还没有预约，去挑选一处休息空间吧。</view><view class="card" wx:for="{{bookings}}" wx:key="id"><view class="row"><view>{{item.station}} · {{item.service}}</view><view class="pill">{{item.statusText}}</view></view><view class="sub">{{item.timeText}} {{item.proxy ? '· 为家人预约' : ''}}</view><view class="code">{{item.code}}</view><view class="actions" wx:if="{{item.status === 'confirmed'}}"><button class="primary" bindtap="complete" data-id="{{item.id}}">演示核销</button><button bindtap="change" data-id="{{item.id}}">跨站改签</button><button bindtap="cancel" data-id="{{item.id}}">取消</button></view></view><view class="card"><view class="row"><view class="title">服务与排队</view><button class="text-btn" bindtap="go" data-view="care">服务中心 →</button></view><view class="line" wx:for="{{queues}}" wx:key="id"><view class="row"><text>{{item.service}} · {{item.number}}</text><view class="pill">{{item.status}}</view></view><view class="sub">前方{{item.ahead}}组 · 约{{item.eta}}分钟</view></view><view class="line" wx:for="{{serviceRequests}}" wx:key="id"><view class="row"><text>{{item.service}}</text><view class="pill">{{item.status}}</view></view></view><view wx:if="{{!queues.length && !serviceRequests.length}}" class="sub">暂无服务记录</view></view><view class="card"><view class="title">我的反馈</view><view wx:for="{{tickets}}" wx:key="id" class="line"><view class="pill">{{item.status}}</view><view>{{item.text}}</view></view><button bindtap="go" data-view="feedback">提交反馈 / 文字呼叫</button></view><view class="card"><view class="title">常跑路线</view><view wx:for="{{state.favorites}}" wx:key="index">{{item.origin}} → {{item.destination}}</view></view><view class="card"><view class="title">数据小账本</view><view class="ledger-row"><text>预约记录</text><b>{{bookings.length}}</b></view><view class="ledger-row"><text>服务及排队</text><b>{{queues.length + serviceRequests.length}}</b></view><view class="ledger-row"><text>反馈记录</text><b>{{tickets.length}}</b></view><view class="ledger-row"><text>实时位置</text><b>未采集</b></view><button bindtap="toggle" data-key="large">大字模式：{{state.settings.large ? '开' : '关'}}</button><button bindtap="toggle" data-key="night">夜间模式：{{state.settings.night ? '开' : '关'}}</button><button bindtap="toggle" data-key="incognito">无痕浏览：{{state.settings.incognito ? '开' : '关'}}</button><view class="sub">记录只保存在本设备，保留至主动删除。无痕模式不写入存储。</view><button bindtap="clear">删除本设备全部演示数据</button><button bindtap="go" data-view="ops">运营看板（演示）</button></view></block>
<block wx:if="{{view === 'feedback'}}"><view class="card"><view class="title">你的反馈，会被认真看见</view><picker range="{{stationNames}}" value="{{stationIndex}}" bindchange="field" data-key="stationIndex"><view class="field">{{stationNames[stationIndex]}}</view></picker><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="field" data-key="kindIndex"><view class="field">{{kinds[kindIndex]}}</view></picker><textarea class="field" placeholder="请描述具体位置和问题（5至300字）" maxlength="300" value="{{feedback}}" bindinput="field" data-key="feedback"/><button class="primary" bindtap="feedback">提交演示工单</button><view class="notice">不会通知真实工作人员。紧急情况请直接联系现场工作人员或当地紧急服务。</view></view></block>
<block wx:if="{{view === 'ops'}}"><view class="card"><view class="title">运营驾驶舱 · 本地演示</view><view>待到站 {{pending}} · 已完成 {{completed}} · 排队 {{queues.length}}</view><view class="number">{{carbon}} <text class="sub">kg 估算减排</text></view><view class="sub">生产环境需接入管理身份验证与设备数据；本页不下发任何设备指令。</view></view><view class="card"><view class="title">服务协同队列</view><view wx:for="{{serviceRequests}}" wx:key="id" class="line"><view class="row"><view>{{item.service}}</view><view class="pill">{{item.status}}</view></view><button wx:if="{{item.status !== '已完成'}}" bindtap="progressService" data-id="{{item.id}}">{{item.status === '已登记' ? '开始准备' : '标记完成'}}</button></view><view wx:if="{{!serviceRequests.length}}" class="sub">暂无服务请求</view></view><view class="card" wx:for="{{stations}}" wx:key="id"><view class="title">{{item.name}}</view><view>车位 {{item.parking}} · 充电 {{item.charging}} · 空舱 {{item.slots}}</view><view class="sub">示例绿电 {{item.green}}% · 噪声 {{item.quiet}} dB</view></view><view class="card"><view class="title">工单处理</view><view wx:for="{{tickets}}" wx:key="id" class="line"><view>{{item.kind}} · {{item.status}}</view><view class="sub">{{item.text}}</view><button wx:if="{{item.status !== '已解决'}}" bindtap="progress" data-id="{{item.id}}">{{item.status === '待处理' ? '接单处理' : '标记解决'}}</button></view><view wx:if="{{!tickets.length}}" class="sub">暂无工单</view></view></block>
<view class="nav"><button wx:for="{{nav}}" wx:key="id" class="{{view === item.id ? 'active' : ''}}" bindtap="go" data-view="{{item.id}}"><text>{{item.icon}}</text><label>{{item.name}}</label></button></view>
</view>
