.hero{min-height:560rpx;background-image:linear-gradient(90deg,#052f4fe8 0%,#07466fc9 48%,#0b527c38 100%),url('/assets/hero-service-area.jpg');background-size:cover;background-position:center;color:#fff}.hero .sub{color:#e4eff4}.hero-kicker{color:#f1d49d}.hero-metrics{background:#073b5a72;padding:20rpx;border-radius:10rpx;backdrop-filter:blur(10rpx)}
.quick{margin-top:-44rpx}.quick button,.quick button:nth-child(2),.quick button:nth-child(3){position:relative;overflow:hidden;min-height:220rpx;padding:24rpx 17rpx;text-align:left;color:#fff;background-size:cover;background-position:center;border-color:#ffffff66;box-shadow:0 18rpx 40rpx #173c542d}.quick button:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#07324a15 5%,#052a43dc 100%)}.quick button:nth-child(1){background-image:url('/assets/rest-area.jpg')}.quick button:nth-child(2){background-image:url('/assets/hero-service-area.jpg');background-position:68% center}.quick button:nth-child(3){background-image:url('/assets/family-corner.jpg')}.quick button:nth-child(4){background-image:url('/assets/truck-charging.jpg')}.quick button text,.quick button view,.quick button label{position:relative;z-index:1;color:#fff}.quick button text{display:inline-grid;place-items:center;width:56rpx;height:56rpx;border-radius:9rpx;background:#f8fbfddd;color:#0a5c85}.quick button label{color:#d9e8ef}
.journey-grid button{background-size:cover;background-position:center;overflow:hidden}.journey-grid button:before{content:'';position:absolute;inset:0;background:linear-gradient(145deg,#063652e8,#0b476dc2)}.journey-grid button:nth-child(1){background-image:url('/assets/hero-service-area.jpg')}.journey-grid button:nth-child(2){background-image:url('/assets/truck-charging.jpg')}.journey-grid button:nth-child(3){background-image:url('/assets/family-corner.jpg')}.journey-grid button:nth-child(4){background-image:url('/assets/rest-area.jpg')}.journey-grid button>view,.journey-grid button>label,.journey-grid button>text{position:relative;z-index:1}
.station-card{overflow:hidden;padding-top:0}.station-cover{display:block;width:calc(100% + 60rpx);height:210rpx;margin:0 -30rpx 26rpx}
.persona>view{position:relative;overflow:hidden;min-height:150rpx;color:#fff;background-size:cover;background-position:center;border:0}.persona>view:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#052e48e6,#06385493)}.persona>view:nth-child(1){background-image:url('/assets/family-corner.jpg')}.persona>view:nth-child(2){background-image:url('/assets/rest-area.jpg')}.persona>view:nth-child(3){background-image:url('/assets/truck-charging.jpg')}.persona-icon,.persona>view>view{position:relative;z-index:1}.persona label{color:#d8e7ee}
.care-head{background-image:linear-gradient(90deg,#063857ed,#0a557db0),url('/assets/rest-area.jpg');background-size:cover;background-position:center}
.service-item{overflow:hidden;padding:0 23rpx 23rpx}.service-cover{grid-column:1/4;display:block;width:calc(100% + 46rpx);height:190rpx;margin:0 -23rpx 8rpx}.service-icon{margin-top:10rpx}.service-copy{margin-top:10rpx}

/* Exact quick-card scenes plus a clearer, brighter road blue. */
page{background:#e9f3f9}.page{background:linear-gradient(145deg,#f2f8fb,#e2f0f7)}
.top-head{background:#fbfdfeef;border-color:#cfe1eb}.brand{color:#0674b2}.route-chip{background:#e2f1f9;border-color:#c2dfed;color:#1f74a2}
.hero{background-image:linear-gradient(90deg,#004d83e8 0%,#0069a9c9 48%,#087ab33b 100%),url('/assets/hero-service-area.jpg')}.quick button:after{background:linear-gradient(180deg,#00669b08 5%,#00466fdf 100%)}
.quick button:nth-child(1){background-image:url('/assets/quick-sleep.jpg')}.quick button:nth-child(2){background-image:url('/assets/quick-shower.jpg');background-position:center}.quick button:nth-child(3){background-image:url('/assets/quick-family.jpg')}.quick button:nth-child(4){background-image:url('/assets/quick-truck.jpg')}
.journey-grid button:before{background:linear-gradient(145deg,#00558ce8,#0876b6c9)}
.quick button text{color:#0874b1}.primary{background:#0879b9}.service-entry{color:#076da7;border-color:#c4dfec}.nav .active{color:#0876b5;box-shadow:inset 0 4rpx 0 #d4a551}.night-card{background:linear-gradient(135deg,#066ba6,#1685bc)}

/* Richer content below journey planning. */
.plan-strategy{display:grid;gap:14rpx}.plan-strategy>view{display:flex;gap:22rpx;align-items:center;padding:25rpx;border-radius:14rpx;color:#fff;background:linear-gradient(135deg,#0876b4,#1592c9)}.plan-strategy>view:nth-child(2){background:linear-gradient(135deg,#076aa6,#0d83bb)}.plan-strategy>view:nth-child(3){background:linear-gradient(135deg,#086399,#177ba9)}.plan-strategy text{font-size:42rpx;font-family:serif;color:#f0d297}.plan-strategy label,.plan-strategy b,.plan-strategy small{display:block}.plan-strategy label{font-size:19rpx;color:#cbe7f3}.plan-strategy b{font-size:25rpx;margin:7rpx 0}.plan-strategy small{font-size:19rpx;color:#e2f1f7}.plan-check{margin-top:22rpx}.plan-check checkbox-group{display:grid;gap:10rpx;margin-top:20rpx}.plan-check checkbox-group label{background:#eef6fa;border:1rpx solid #d2e4ed;border-radius:9rpx;padding:19rpx;font-size:22rpx}.preference-help>view:not(.title){display:grid;grid-template-columns:180rpx 1fr;gap:12rpx;padding:18rpx 0;border-top:1rpx solid #dce7ed}.preference-help>view:nth-child(2){margin-top:18rpx}.preference-help b{color:#0872ad;font-size:21rpx}.preference-help text{color:#6d7f8c;font-size:20rpx;line-height:1.5}.night .plan-check checkbox-group label{background:#21475b;border-color:#376277}.night .preference-help>view:not(.title){border-color:#365a6e}.night .preference-help text{color:#b9c8d1}

/* Chinese expressway service-area reference map. */
.map-kicker{font-size:20rpx;color:#087fb8;letter-spacing:2rpx;margin-bottom:10rpx}.real-map{height:720rpx;background:linear-gradient(180deg,#eaf4ed 0 45%,#e7edf3 45% 80%,#3a5369 80%);border:1rpx solid #bad0dc;border-radius:12rpx}.map-building{position:absolute;left:19%;top:8%;width:59%;height:29%;box-sizing:border-box;border:3rpx solid #1882b7;background:#f4fbfe;display:flex;justify-content:center;padding:12rpx;color:#086896;font-size:22rpx}.map-green{position:absolute;left:3%;top:14%;width:14%;height:28%;border-radius:45%;background:#cfe4d4;border:2rpx solid #8eb99c;color:#356845;font-size:18rpx;display:flex;align-items:center;justify-content:center}.map-zone{position:absolute;box-sizing:border-box;border:2rpx solid #9eb1c1;background:repeating-linear-gradient(90deg,#f6f8fa 0 35rpx,#b6c4cf 36rpx 38rpx);padding:10rpx;color:#365064;font-size:18rpx}.car-zone{left:18%;top:43%;width:43%;height:18%}.truck-zone{left:18%;top:64%;width:38%;height:15%}.charge-zone{left:63%;top:43%;width:14%;height:18%;background:#e5f5fa}.map-backend{position:absolute;left:58%;top:65%;width:18%;height:13%;border:2rpx dashed #7b8f9f;background:#eef2f5;font-size:16rpx;display:flex;align-items:center;justify-content:center}.map-fuel{position:absolute;right:3%;top:55%;width:16%;height:22%;border:3rpx solid #278cc0;background:#f5fbfd;color:#086999;font-size:18rpx;display:flex;align-items:center;justify-content:center}.map-walk{position:absolute;left:17%;right:21%;top:40%;border-top:5rpx dashed #d49e2f;color:#8b671c;font-size:15rpx;text-align:center}.map-road{position:absolute;left:0;right:0;bottom:0;height:16%;color:#fff;font-size:19rpx;display:flex;align-items:center;justify-content:center}.real-map .map-label{left:4%;top:75%;color:#075f91;background:#fff;padding:5rpx}.real-map button{z-index:3;font-size:16rpx;line-height:1.3;padding:5rpx 9rpx;border:1rpx solid #8cb4c9;border-radius:4rpx;color:#075f91;background:#fffffff0}.map-note,.source-note{padding:16rpx;background:#edf3f7;color:#557085;font-size:19rpx;line-height:1.7;border-radius:8rpx;margin:12rpx 0}.source-note{border-left:5rpx solid #d1a24a;background:#f7f3ea;color:#6f603f}
.refined-map{height:760rpx;border:0;box-shadow:inset 0 0 0 2rpx #b8d0dc,0 16rpx 40rpx #27546d18}.refined-map .map-building{border:0;border-top:8rpx solid #087db8;border-radius:10rpx;background:linear-gradient(180deg,#fff,#e8f2f6);box-shadow:0 12rpx 25rpx #315a7026;flex-direction:column;align-items:center;justify-content:flex-start}.refined-map .map-building small,.refined-map .map-green small,.refined-map .map-zone small{display:block;font-size:13rpx;color:#78909e;margin-top:8rpx}.refined-map .map-building label{position:absolute;bottom:-19rpx;background:#fff;border:2rpx solid #d5aa4a;color:#8b671c;border-radius:14rpx;padding:3rpx 16rpx;font-size:14rpx}.refined-map .map-green{border:0;box-shadow:inset 0 0 0 2rpx #8eb99c;background:radial-gradient(circle at 32% 25%,#6aa17a 0 18rpx,transparent 19rpx),radial-gradient(circle at 68% 61%,#55936a 0 25rpx,transparent 26rpx),#cfe4d4;flex-direction:column}.refined-map .map-zone{border:0;border-radius:8rpx;box-shadow:inset 0 0 0 2rpx #9eb1c1;background-color:#f8fbfc}.refined-map .map-backend{border-radius:8rpx;flex-direction:column;gap:5rpx}.refined-map .map-fuel{border:0;border-radius:9rpx;background:linear-gradient(145deg,#087fb8 0 33%,#fff 33%);box-shadow:0 10rpx 22rpx #24576e24;gap:8rpx}.refined-map .map-walk{border:0;height:7rpx;background:repeating-linear-gradient(90deg,#d9a12d 0 14rpx,transparent 14rpx 23rpx)}.map-loop{position:absolute;left:8%;right:7%;bottom:18%;height:10%;border:10rpx solid #738ba0;border-top:0;border-radius:0 0 70% 70%;color:#50687b;font-size:13rpx;text-align:center}.mini-compass{position:absolute;right:4%;top:3%;z-index:4;color:#345a70;font-size:15rpx;text-align:center}.mini-compass text{display:block;color:#087fb8;font-size:30rpx}.refined-map button{border:0;border-radius:20rpx;box-shadow:0 6rpx 16rpx #214d6420,0 0 0 1rpx #9dc7da;background:#fffffff2}
